PORT=3000
API_PORT=3000
API_DB_PATH=./data/api.db
RATE_LIMIT_MAX=10
YTDLP_TIMEOUT=240000
TMP_DIR=
COOKIES_FILE=
# Instagram: impersonation via curl-cffi (deixe vazio para desativar)
IG_IMPERSONATE=chrome
# TTL da sessão de conta conectada no app (ms; padrão 12h)
IG_SESSION_TTL=43200000
# Login assistido no app (Chromium headless via playwright-core)
IG_LOGIN_ENABLED=true
# Caminho do Chromium/Chrome; vazio detecta automaticamente
IG_BROWSER_PATH=
# Validade da janela de login (ms) e máximo de logins simultâneos
IG_LOGIN_TTL=300000
IG_LOGIN_MAX_SESSIONS=2
IG_LOGIN_NAVIGATION_TIMEOUT=45000
# Limite de abertura de logins por IP
IG_LOGIN_RATE_MAX=5
IG_LOGIN_RATE_WINDOW_MS=600000
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# TRUST_PROXY=true
# LOG_LEVEL=info
# MAX_CONCURRENT_DOWNLOADS=2
# DOWNLOAD_QUEUE_TIMEOUT=30000
# YTDLP_MAX_ATTEMPTS=5
# YTDLP_INITIAL_BACKOFF=2000
# FFMPEG_TIMEOUT=600000
# JOB_TIMEOUT=900000
# BLOCKED_HOSTS=
# MAX_URL_LENGTH=2048

# Validação de vídeos
MAX_VIDEO_DURATION=600       # duração máxima em segundos (600 = 10 minutos)
MAX_FILE_SIZE=104857600      # tamanho máximo em bytes (100MB)
